# Copy this file to .env and fill in your own values. Never commit the real .env file.

# PostgreSQL connection string.
# Local:    postgres://postgres:yourpassword@localhost:5432/portfolio
# Hosted (Render/Supabase/Neon/Railway all give you one of these):
#   postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio

# Most hosted Postgres providers require SSL. Set to "false" only for a
# local database that isn't using SSL.
PGSSL=true

# Port the Express server runs on
PORT=5000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# --- Optional: email notifications for new contact messages ---
# If these are left blank, messages are still saved to Postgres,
# they just won't be emailed to you as well.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where the "someone contacted you" notification email should be sent
CONTACT_NOTIFY_EMAIL=nigussieeskedar@gmail.com

# Shared secret required (as an x-admin-key header) to read saved messages
# back via GET /api/contact. Set this to something long and random.
ADMIN_KEY=
